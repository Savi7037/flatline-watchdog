# Required
TELEGRAM_BOT_TOKEN=token_from_botfather
BASE_URL=https://flatline.example.com

# Strongly recommended: your Telegram chat ID. Without it, anyone who finds your bot can use it.
ALLOWED_CHATS=

# Optional
DB_PATH=flatline.db
APP_HOST=127.0.0.1
APP_PORT=8091
MAX_BOTS=10
# An outside monitor, such as a Healthchecks.io ping URL. It's pinged only while Flatline is healthy.
HEARTBEAT_URL=
